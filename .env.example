# Copy to .env (gitignored). Only VLLM_BASE_URL is needed.
# Server root, without /v1 (/tokenize and /metrics live at the root)
VLLM_BASE_URL=http://localhost:8000
# Optional: defaults to the first model /v1/models lists
VLLM_MODEL=
# Optional: only if the server was started with --api-key (sent as a bearer token)
VLLM_API_KEY=
